                      opacity: [0, 1, 1]
                    }}
                    transition={{ duration: 0.5 }}
                  >
                      <motion.div 
                        className="w-3 h-3 bg-white rounded-full"
                        animate={{
                          scale: [1, 1.2, 1],
                          opacity: [0.7, 1, 0.7]
                        }}
                        transition={{
                          duration: 2,
                          repeat: Infinity,
                          repeatType: "reverse"
                        }}
                      ></motion.div>
                  </motion.div>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div className="md:text-right md:pr-12 pl-4 md:pl-0">
                      <motion.div 
                          className="bg-white/5 backdrop-blur-sm border border-white/10 p-6 rounded-xl transition-all duration-300 hover:bg-white/10"
                          whileHover={{ 
                            scale: 1.03, 
                            boxShadow: "0 10px 25px -5px rgba(0, 0, 0, 0.2)"
                          }}
                        >
                          <div className="text-primary font-mono text-sm mb-2">AUGUST 2023</div>
                          <h4 className="text-xl font-bold mb-2 text-white">Hexathon</h4>
                          <p className="text-gray-300 text-sm">Six-hour rapid ideation and prototyping competition.</p>
                          <motion.a 
                            href="#" 
                            className="inline-flex items-center mt-3 text-primary text-sm font-medium group"
                            whileHover={{ x: 3 }}
                          >
                            View event
                            <svg className="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                              <path fillRule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clipRule="evenodd" />
                            </svg>
                          </motion.a>
                        </motion.div>
                      </div>
                    </div>
                  </div>
                  
                  {/* Future events indicator */}
                  <motion.div 
                    variants={itemVariants} 
                    whileInView={{ opacity: 1, y: 0 }}
                    initial={{ opacity: 0, y: 30 }}
                    viewport={{ once: true, margin: "-100px" }}
                    className="relative"
                  >
                    <motion.div 
                      className="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-8 h-8 bg-gradient-to-br from-gray-600 to-gray-800 rounded-full shadow-lg shadow-gray-500/30 flex items-center justify-center"
                      whileInView={{
                        scale: [0, 1.5, 1],
                        opacity: [0, 1, 1]
                      }}
                      transition={{ duration: 0.5 }}
                    >
                      <motion.div 
                        className="w-full h-full rounded-full flex items-center justify-center"
                        animate={{
                          boxShadow: ["0 0 0 0 rgba(255, 0, 0, 0)", "0 0 0 10px rgba(255, 0, 0, 0.1)", "0 0 0 20px rgba(255, 0, 0, 0)"],
                        }}
                        transition={{
                          duration: 2,
                          repeat: Infinity,
                          repeatType: "loop"
                        }}
                      >
                        <svg className="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                      </motion.div>
                    </motion.div>
                    <div className="text-center mt-6 text-gray-400 italic text-sm">
                      Stay tuned for more upcoming events...
                  </div>
                </motion.div>
              </div>
            </div>
          </motion.div>
          
            {/* Replace CTA section with Team transition */}
          <motion.div 
            variants={itemVariants}
            whileInView={{ opacity: 1, y: 0 }}
            initial={{ opacity: 0, y: 30 }}
            viewport={{ once: true, margin: "-100px" }}  
              className="flex flex-col items-center mt-24 relative"
            >
              {/* Team transition section */}
              <div className="relative w-full h-40 overflow-hidden">
                {/* Wave design */}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" className="absolute w-full">
                  <path 
                    fill="rgba(255, 0, 0, 0.05)" 
                    fillOpacity="1" 
                    d="M0,224L48,224C96,224,192,224,288,208C384,192,480,160,576,176C672,192,768,256,864,272C960,288,1056,256,1152,224C1248,192,1344,160,1392,144L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
                  ></path>
                </svg>
                
                {/* Down arrow with text */}
                <div className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-center">
                  <motion.div
                    className="flex flex-col items-center"
                    initial={{ opacity: 0, y: -20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.5, duration: 0.8 }}
                  >
                    <h3 className="text-2xl font-bold text-white mb-4">Meet Our Team</h3>
            <motion.div 
                      className="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center"
              animate={{
                        y: [0, 10, 0],
              }}
              transition={{
                        duration: 2,
                repeat: Infinity,
                repeatType: "reverse"
              }}
                    >
                      <svg 
                        xmlns="http://www.w3.org/2000/svg" 
                        className="h-5 w-5 text-primary" 
                        fill="none" 
                        viewBox="0 0 24 24" 
                        stroke="currentColor"
                      >
                        <path 
                          strokeLinecap="round" 
                          strokeLinejoin="round" 
                          strokeWidth={2} 
                          d="M19 14l-7 7m0 0l-7-7m7 7V3" 
                        />
                      </svg>
                    </motion.div>
                  </motion.div>
                </div>
            </div>
          </motion.div>
        </motion.div>
        </div>
    </section>

      {/* CSS for special effects */}
      <style dangerouslySetInnerHTML={{ __html: `
        .text-gradient-primary {
          background: linear-gradient(to right, var(--color-primary), #ef4444);
          -webkit-background-clip: text;
          background-clip: text;
          color: transparent;
        }
        
        @keyframes spin {
          from {
            transform: rotate(0deg);
          }
          to {
            transform: rotate(360deg);
          }
        }
        
        .bg-grid-pattern {
          background-size: 30px 30px;
          background-image: linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                            linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        }
        
        .custom-scroll-text {
          font-size: 4rem;
          font-weight: 800;
          color: white;
        }
        
        .gradient-transition {
          position: absolute;
          left: 0;
          right: 0;
          height: 200px;
          pointer-events: none;
        }
        
        .gradient-transition-top {
          top: -1px;
          background: linear-gradient(to bottom, #0A0A0A, transparent);
          z-index: 1;
        }
        
        .gradient-transition-bottom {
          bottom: -1px;
          background: linear-gradient(to top, #0A0A0A, transparent);
          z-index: 1;
        }
      `}} />
    </>
  );
};

export default Events;