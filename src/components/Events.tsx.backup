                    </motion.div>
                  </div>
                  
                  <div className="p-6 bg-gradient-to-t from-white/5 to-transparent">
                    <h3 className="text-xl font-bold text-white mb-2 group-hover:text-primary transition-colors duration-300">
                    {event.title}
