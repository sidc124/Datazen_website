// Define an interface for event data
interface EventData {
  id: number;
  title: string;
  description: string;
  image: string;
  date: string;
  category: string;
}

// Add types for the Popup component props
interface PopupProps {
  event: EventData | null;
  onClose: () => void;
}

// CSS for special effects
const styles = {
  textGradient: "bg-gradient-to-r from-primary to-red-600 bg-clip-text text-transparent",
  glassPanel: "bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl",
  gridPattern: {
    backgroundSize: "30px 30px",
    backgroundImage: "linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px)"
  },
  rotateAnimation: {
    animation: "spin 15s linear infinite"
  }
};

const Popup = ({ event, onClose }: PopupProps) => {
  if (!event) return null;

  return (
    <motion.div 
      className="fixed inset-0 flex justify-center items-center z-50"
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      exit={{ opacity: 0 }}
    >
      <motion.div 
        className="absolute inset-0 bg-black/70 backdrop-blur-sm"
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        onClick={onClose}
      />
      
      <motion.div 
        className="relative bg-gradient-to-br from-white to-gray-100 rounded-2xl p-8 max-w-2xl w-full mx-4 shadow-2xl overflow-hidden z-10"
        initial={{ scale: 0.9, y: 20, opacity: 0 }}
        animate={{ scale: 1, y: 0, opacity: 1 }}
        exit={{ scale: 0.9, y: 20, opacity: 0 }}
        transition={{ type: "spring", damping: 25 }}
      >
        {/* Decorative elements */}
        <div className="absolute -top-20 -right-20 w-40 h-40 bg-primary/10 rounded-full blur-3xl"></div>
        <div className="absolute -bottom-20 -left-20 w-40 h-40 bg-blue-500/10 rounded-full blur-3xl"></div>
        
        <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-blue-500"></div>
        
        <div className="flex flex-col md:flex-row gap-6">
          <motion.div 
            className="w-full md:w-2/5 aspect-video rounded-xl overflow-hidden"
            initial={{ x: -20, opacity: 0 }}
            animate={{ x: 0, opacity: 1 }}
            transition={{ delay: 0.1 }}
          >
            <img 
              src={event.image} 
              alt={event.title} 
              className="w-full h-full object-cover"
            />
          </motion.div>
          
          <div className="w-full md:w-3/5">
            <motion.div 
              className="inline-block px-3 py-1 mb-3 bg-primary/10 rounded-full"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ delay: 0.2 }}
            >
              <span className="text-primary text-sm font-medium">{event.category}</span>
            </motion.div>
            
            <motion.h2 
              className="text-2xl md:text-3xl font-bold mb-3 text-gray-900"
              initial={{ y: -10, opacity: 0 }}
              animate={{ y: 0, opacity: 1 }}
              transition={{ delay: 0.3 }}
            >
              {event.title}
            </motion.h2>
            
            <motion.p 
              className="text-gray-700 mb-4 leading-relaxed"
              initial={{ y: 10, opacity: 0 }}
              animate={{ y: 0, opacity: 1 }}
              transition={{ delay: 0.4 }}
            >
              {event.description}
            </motion.p>
            
            <motion.div 
              className="flex items-center mb-6"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ delay: 0.5 }}
            >
              <div className="w-4 h-4 rounded-full bg-primary/20 flex items-center justify-center mr-2">
                <div className="w-2 h-2 rounded-full bg-primary"></div>
              </div>
              <div className="text-gray-600">{event.date}</div>
            </motion.div>
            
            <motion.div 
              className="flex gap-3"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ delay: 0.6 }}
            >
              <motion.button 
                className="px-5 py-2.5 bg-primary text-white font-medium rounded-lg shadow-md hover:shadow-lg flex items-center gap-2"
                whileHover={{ scale: 1.03 }}
                whileTap={{ scale: 0.98 }}
              >
                Register now
                <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </motion.button>
              
              <motion.button 
                onClick={onClose} 
                className="px-5 py-2.5 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50"
                whileHover={{ scale: 1.03 }}
                whileTap={{ scale: 0.98 }}
          >
            Close
              </motion.button>
            </motion.div>
          </div>
        </div>
      </motion.div>
    </motion.div>
  );
};

const Events = () => {
  const [isVisible, setIsVisible] = useState(false);
  const [hoveredEvent, setHoveredEvent] = useState<number | null>(null);
  const [isPopupOpen, setIsPopupOpen] = useState(false);
  const [selectedEvent, setSelectedEvent] = useState<EventData | null>(null);
  const sectionRef = useRef<HTMLElement>(null);

  // Reduced velocity for smoother animation  
  const velocity = 8;
  
  const { scrollYProgress } = useScroll({
    target: sectionRef,
    offset: ["start end", "end start"]
  });
  
  const y = useTransform(scrollYProgress, [0, 1], [0, -50]);
  const opacity = useTransform(scrollYProgress, [0, 0.3, 0.8, 1], [0.7, 1, 1, 0.7]);
  const scale = useTransform(scrollYProgress, [0, 0.5, 1], [0.9, 1, 0.95]);

  useEffect(() => {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setIsVisible(true);
          observer.unobserve(entry.target);
        }
      },
      {
        threshold: 0.2,
      }
    );

    if (sectionRef.current) {
      observer.observe(sectionRef.current);
    }

    return () => {
      if (sectionRef.current) {
        observer.unobserve(sectionRef.current);
      }
    };
  }, []);

  const containerVariants = {
    hidden: { opacity: 0 },
    visible: {
      opacity: 1,
      transition: {
        staggerChildren: 0.1,
        delayChildren: 0.2,
      },
    },
  };

  const itemVariants = {
    hidden: { opacity: 0, y: 30 },
    visible: {
      opacity: 1,
      y: 0,
      transition: {
        duration: 0.6,
        ease: [0.25, 0.1, 0.25, 1],
      },
    },
  };

  const cardVariants = {
    rest: { 
      scale: 1,
      boxShadow: "0 4px 6px -1px rgba(0, 0, 0, 0.1)"
    },
    hover: { 
      scale: 1.03, 
      y: -8,
      boxShadow: "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
    }
  };

  const imageVariants = {
    rest: { scale: 1 },
    hover: { scale: 1.08, transition: { duration: 0.8 } }
  };

  return (
    <>
    <section 
      id="events" 
      ref={sectionRef}
        className="relative pt-28 pb-20 md:pt-40 md:pb-32 px-4 bg-[#0A0A0A] overflow-hidden"
      >
        {/* Background elements */}
        <div className="absolute inset-0 w-full h-full overflow-hidden">
          <motion.div 
            className="absolute w-full h-full bg-gradient-to-b from-black/70 via-[#0A0A0A] to-[#0A0A0A]"
            style={{ opacity }}
          />
          
          {/* Animated gradient spots */}
          <motion.div 
            className="absolute top-10 right-[10%] w-[30rem] h-[30rem] rounded-full bg-primary/5 filter blur-[100px]"
            animate={{
              scale: [1, 1.2, 1],
              opacity: [0.15, 0.25, 0.15],
              y: [0, -30, 0]
            }}
            transition={{
              duration: 15,
              repeat: Infinity,
              repeatType: "reverse"
            }}
          />
          
          <motion.div 
            className="absolute -bottom-20 left-[5%] w-[35rem] h-[35rem] rounded-full bg-blue-500/5 filter blur-[120px]"
            animate={{
              scale: [1.2, 1, 1.2],
              opacity: [0.12, 0.18, 0.12],
              y: [0, 40, 0]
            }}
            transition={{
              duration: 18,
              repeat: Infinity,
              repeatType: "reverse"
            }}
          />
          
          <motion.div 
            className="absolute top-[40%] left-[50%] transform -translate-x-1/2 -translate-y-1/2 w-[25rem] h-[25rem] rounded-full bg-purple-500/5 filter blur-[80px]"
            animate={{
              scale: [1, 1.1, 1],
              opacity: [0.08, 0.15, 0.08],
            }}
            transition={{
              duration: 12,
              repeat: Infinity,
              repeatType: "reverse"
            }}
          />
          
          {/* Grid pattern */}
          <div 
